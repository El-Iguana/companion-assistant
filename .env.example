# Pantheon — copy to .env and edit. compose reads it; INSTALL.md explains each.

# ── Where Pantheon listens ───────────────────────────────────────────────────
# Always this computer only: http://127.0.0.1:<port> (INSTALL.md, "Other devices").
PANTHEON_PORT=7861

# The first ADMIN password, read once when the first account is created.
# Leave empty for a random one (in the log and data/auth/INITIAL_PASSWORD).
PANTHEON_ADMIN_PASSWORD=

# Your time zone (a tz database name), for timestamps and "what time is it?".
TZ=UTC

# ── Backends ─────────────────────────────────────────────────────────────────
# KoboldCPP (required) and ComfyUI (optional, for expression sprites).
# The defaults are "on this computer". Remote example: http://192.168.1.20:5001
# compose.koboldcpp.yaml and compose.ai-stack.yaml set these themselves.
#KOBOLD_URL=http://host.docker.internal:5001
#COMFYUI_URL=http://host.docker.internal:8188

# ── KoboldCPP in a container (compose.koboldcpp.yaml) ────────────────────────
# Folder holding .gguf models, and the one to load (a file name in it).
KOBOLD_MODELS_DIR=./llm-models
KOBOLD_MODEL=
# Layers on the GPU: -1 = all. Lower it if the model does not fit in VRAM.
KOBOLD_GPU_LAYERS=-1
KOBOLD_CONTEXT=8192
# Anything else for koboldcpp, e.g. --flashattention
KOBOLD_ARGS=

# ── Which compose files ──────────────────────────────────────────────────────
# Saves typing -f every time. The separator is ":" on Linux and macOS, ";" on
# Windows. Uncomment ONE line:
#
# KoboldCPP container + NVIDIA, Docker:
#COMPOSE_FILE=compose.yaml:compose.koboldcpp.yaml:compose.gpu.docker.yaml
# …the same on Windows:
#COMPOSE_FILE=compose.yaml;compose.koboldcpp.yaml;compose.gpu.docker.yaml
# KoboldCPP container + NVIDIA, Podman:
#COMPOSE_FILE=compose.yaml:compose.koboldcpp.yaml:compose.gpu.podman.yaml
# ai-stack's backends (Linux):
#COMPOSE_FILE=compose.yaml:compose.ai-stack.yaml

# ── Optional ─────────────────────────────────────────────────────────────────
# Piper voices folder (each voice = .onnx + .onnx.json). Default ./voices.
# On the ai-stack workstation: ../jarvis
#PIPER_VOICES_DIR=./voices
