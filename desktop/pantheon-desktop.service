# Cantinero desktop avatar, as a systemd --user unit (optional: running
# ./desktop/pantheon-desktop.py by hand works just as well).
#
# A unit so she comes up with your graphical session, and so systemd restarts
# her if she crashes. Units started by the user manager inherit WAYLAND_DISPLAY,
# DISPLAY and XAUTHORITY from the session.
#
# Install it rendered, with @DIR@ = this checkout (see desktop/README.md):
#   sed "s|@DIR@|$PWD|g" desktop/pantheon-desktop.service \
#     > ~/.config/systemd/user/pantheon-desktop.service
[Unit]
Description=Cantinero desktop avatar
# She is a window onto the companion-assistant container; without it there is nothing to show.
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
ExecStart=@DIR@/desktop/pantheon-desktop.py
Restart=on-failure
RestartSec=3
# The renderer is a continuous WebGL loop sharing the GPU with KoboldCPP; keep it
# from competing with inference for CPU.
Nice=5

[Install]
WantedBy=graphical-session.target
