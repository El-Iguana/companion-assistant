# Pantheon desktop avatar, as a systemd --user unit.
#
# A unit rather than a bare process for one concrete reason: the stack-ui
# container has the host session bus but NO Wayland display, so anything it
# spawns itself cannot open a window. It can, however, ask the host user manager
# to start this -- and units started there inherit WAYLAND_DISPLAY, DISPLAY and
# XAUTHORITY from the session. One unit therefore gives a launch path that works
# identically from a terminal, from `stack desktop`, and from the dashboard.
#
# Installed by `stack install desktop` (path rendered from @ECO@).
[Unit]
Description=Pantheon desktop avatar
# She is a window onto the companion container; without it there is nothing to show.
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
ExecStart=@ECO@/companion/desktop/pantheon-desktop.py
Restart=on-failure
RestartSec=3
# The renderer is a continuous WebGL loop sharing the GPU with KoboldCPP and
# ComfyUI; keep it from competing with inference for CPU.
Nice=5

[Install]
WantedBy=graphical-session.target
