# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# Virtualenvs (deps live in the container image, not the source tree)
venv/
.venv/

# Live app state — mounted volume of per-item JSON (characters, sessions,
# relationships, etc.). Runtime data, not source; back up separately.
# Private user libraries. Ignored wholesale EXCEPT the avatar baseline model:
# git cannot re-include a file whose parent dir is excluded, so the path has to
# be un-ignored one level at a time.
data/*
!data/vrm/
data/vrm/*
!data/vrm/baseline.vrm

# Baked ML model artifacts (downloaded at image build time, not versioned here)
models/*.onnx
models/*.bin
models/kokoro/
models/rembg/

# Misc
*.wav
.env
*.log
.aider*
.idea
.obsidian

# Local model/voice folders for compose (INSTALL.md); only the placeholders
# are tracked.
llm-models/*
!llm-models/.gitkeep
voices/*
!voices/.gitkeep

# pytincture page: the browser wapyt wheel (dev_wheel.sh locally, the Containerfile in the image)
appcode/wapyt-*.whl

# Eval results and raw model outputs stay on the machine that ran them
eval/companion_memory/RESULTS.md
eval/companion_memory/baseline/
